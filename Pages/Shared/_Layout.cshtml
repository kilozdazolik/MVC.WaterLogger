<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WaterLogger</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-900 flex flex-col min-h-screen">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <nav class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
            <a class="text-xl font-black text-blue-600 tracking-tighter" asp-page="/Index">WATER<span class="text-slate-400">LOG</span></a>
            
            <div class="flex gap-6 text-sm font-bold uppercase tracking-widest text-slate-500">
                <a class="hover:text-blue-600 transition-colors" asp-page="/Index">Dashboard</a>
                <a class="hover:text-blue-600 transition-colors" asp-page="/DailyGoal">Set Goal</a>
                <a class="hover:text-blue-600 transition-colors" asp-page="/History">Edit Logs</a>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-slate-200 py-6 mt-auto">
        <div class="max-w-4xl mx-auto px-4 text-center">
            <p class="text-slate-400 text-sm font-medium">
                Made with <span class="text-red-400">♥</span> by <span class="text-slate-600 font-bold">kilozdazolik</span>
            </p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>