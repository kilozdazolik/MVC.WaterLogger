@page
@model kilozdazolik.WaterLogger.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var dailyGoal = Model.TodayGoal.GoalMl;
    var currentAmount = Model.WaterLogs.Sum(x => x.Volume);
    var percentage = dailyGoal > 0 ? Math.Min(100, (int)((double)currentAmount / dailyGoal * 100)) : 0;
    double circumference = 2 * Math.PI * 45;
    double offset = circumference - (percentage / 100.0 * circumference);
}

<div class="py-8 px-4">
    <div class="max-w-4xl mx-auto">
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
            <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 flex flex-col items-center justify-center">
                <div class="relative w-40 h-40">
                    <svg class="w-full h-full transform -rotate-90">
                        <circle cx="80" cy="80" r="45" fill="transparent" stroke="currentColor" stroke-width="8" class="text-slate-100" />
                        <circle cx="80" cy="80" r="45" fill="transparent" stroke="currentColor" stroke-width="8"
                                stroke-dasharray="@circumference" stroke-dashoffset="@offset"
                                class="text-blue-500 transition-all duration-700" stroke-linecap="round" />
                    </svg>
                    <div class="absolute inset-0 flex flex-col items-center justify-center">
                        <span class="text-3xl font-black italic">@percentage%</span>
                    </div>
                </div>
                <p class="mt-4 text-slate-500 font-bold text-sm">@currentAmount / @dailyGoal ml</p>
            </div>

            <!-- Add Water Section -->
            <div class="md:col-span-2 bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                <h2 class="text-lg font-black uppercase tracking-widest text-slate-400 mb-6 text-center md:text-left">Add Water</h2>
                
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="mb-4 p-4 text-sm text-red-600 bg-red-50 rounded-xl font-bold">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <!-- Fixed Vessels Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-6">
                    @foreach (var vessel in Model.VesselTypes)
                    {
                        <form method="post" asp-page-handler="Add" asp-route-vesselId="@vessel.Id">
                            <button type="submit" class="w-full p-4 rounded-2xl bg-blue-50 hover:bg-blue-600 text-blue-700 hover:text-white transition-all font-bold border border-blue-100 text-center">
                                @vessel.Name
                                <span class="block text-xs opacity-60">@vessel.CapacityMl ml</span>
                            </button>
                        </form>
                    }
                </div>

                <div class="pt-6 border-t border-slate-100">
                    <form method="post" asp-page-handler="Add" class="flex items-center gap-2">
                        <div class="relative flex-grow">
                            <input type="number" name="manualAmount" required min="1" max="5000" placeholder="Custom amount (e.g. 330)"
                                   class="w-full pl-4 pr-12 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500 outline-none font-bold text-slate-700" />
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-xs">ML</span>
                        </div>
                        <button type="submit" class="bg-slate-800 hover:bg-black text-white px-8 py-3 rounded-xl font-bold transition-all shadow-lg active:scale-95">
                            Add
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- History Table -->
        <div class="bg-white rounded-3xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="p-6 border-b border-slate-50">
                <h2 class="font-black text-slate-800 uppercase tracking-widest text-sm">Recent Intake</h2>
            </div>
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50/50 text-[10px] font-black text-slate-400 uppercase tracking-widest">
                        <th class="px-8 py-4">Time</th>
                        <th class="px-8 py-4">Vessel</th>
                        <th class="px-8 py-4 text-right">Volume</th>
                        <th class="px-8 py-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-50">
                    @foreach (var log in Model.WaterLogs)
                    {
                        <tr class="hover:bg-slate-50 transition-colors">
                            <td class="px-8 py-4 text-sm font-bold text-slate-400">@log.Timestamp.ToString("HH:mm")</td>
                            <td class="px-8 py-4 text-sm font-black text-slate-700">@(log.VesselType?.Name ?? "Custom")</td>
                            <td class="px-8 py-4 text-sm font-bold text-blue-600 text-right">@log.Volume ml</td>
                            <td class="px-8 py-4 text-center">
                                <div class="flex justify-center gap-3">
                                    <button type="button" onclick="openEditModal(@log.Id, @log.Volume)"
                                            class="p-2 text-slate-400 hover:text-blue-600 transition-all">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                        </svg>
                                    </button>
                                    <form method="post" asp-page-handler="Delete" asp-route-id="@log.Id" onsubmit="return confirm('Delete?')">
                                        <button type="submit" class="p-2 text-slate-400 hover:text-red-600 transition-all">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Edit Modal -->
<div id="editModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl">
        <h3 class="text-xl font-bold mb-4">Edit Intake</h3>
        <form method="post" asp-page-handler="Edit">
            <input type="hidden" id="editLogId" name="id" />
            <div class="mb-6">
                <label class="block text-xs font-bold text-slate-400 uppercase mb-2">New Amount (ml)</label>
                <input type="number" id="editVolume" name="newVolume" required min="1"
                       class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold" />
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="closeEditModal()" class="flex-1 py-3 font-bold text-slate-500">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold">Save</button>
            </div>
        </form>
    </div>
</div>

<!-- Set Goal Modal -->
<div id="goalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[100] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl p-8 max-w-sm w-full shadow-2xl">
        <h3 class="text-xl font-black uppercase tracking-widest text-slate-800 mb-4">Set Daily Goal</h3>
        <form method="post" asp-page-handler="SetGoal">
            <div class="mb-6">
                <label class="block text-[10px] font-black text-slate-400 uppercase mb-2">Target Volume (ml)</label>
                <input type="number" name="goalAmount" value="@Model.TodayGoal.GoalMl" required min="1" max="10000"
                       class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl font-bold text-slate-700 outline-none focus:ring-2 focus:ring-blue-500 transition-all" />
            </div>
            <div class="flex gap-3">
                <button type="button" onclick="closeGoalModal()" class="flex-1 py-3 font-bold text-slate-400 hover:text-slate-600 transition-colors">Cancel</button>
                <button type="submit" class="flex-1 py-3 bg-blue-600 text-white rounded-xl font-bold shadow-lg shadow-blue-100 active:scale-95 transition-all">Update</button>
            </div>
        </form>
    </div>
</div>

<script>
    function openEditModal(id, currentVolume) {
        document.getElementById('editLogId').value = id;
        document.getElementById('editVolume').value = currentVolume;
        document.getElementById('editModal').classList.remove('hidden');
    }
    function closeEditModal() {
        document.getElementById('editModal').classList.add('hidden');
    }

        function openGoalModal() {
        document.getElementById('goalModal').classList.remove('hidden');
    }
    function closeGoalModal() {
        document.getElementById('goalModal').classList.add('hidden');
    }
</script>